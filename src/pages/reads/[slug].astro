---
// src/pages/reads/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildReadTitle, buildReadDescription, buildBreadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  const reads = await getCollection('reads');
  return reads.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateObj = new Date(entry.data.pubDate);
const isoDate = dateObj.toISOString();
const formattedDate = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Cloudflare Turnstile site key (public). Comment form is disabled if absent.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Canonical URL for this page, for structured data.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// These pages are Pranay's commentary on someone else's article, so they are
// marked up as a BlogPosting citing the source. Review/itemReviewed is not used:
// Google only accepts a fixed list of types under itemReviewed (Book, Product,
// Movie, ...) and a web article fits none of them.
const readSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.takeaway,
  datePublished: isoDate,
  dateModified: isoDate,
  // Article rich results require an image; the social card keeps every read
  // eligible without hand-made artwork per entry.
  image: [new URL('/images/og-default.png', Astro.site).href],
  inLanguage: 'en',
  author: { '@id': 'https://pranaym.com/#person' },
  publisher: { '@id': 'https://pranaym.com/#person' },
  isPartOf: { '@id': 'https://pranaym.com/#website' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  isBasedOn: {
    '@type': 'CreativeWork',
    name: entry.data.title,
    author: { '@type': 'Person', name: entry.data.author },
    url: entry.data.url,
  },
};

const breadcrumbSchema = buildBreadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Recommended Reading', path: '/reads/' },
  { name: entry.data.title, path: Astro.url.pathname },
]);
---

<BaseLayout
  title={buildReadTitle(entry.data.title, entry.data.seoTitle)}
  description={buildReadDescription(entry.data.title, entry.data.author, entry.data.takeaway)}
  ogType="article"
  publishedTime={isoDate}
>
  <article class="read-detail-article">
    <!-- Back to archive navigation -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/reads/">Recommended Reading</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <header class="read-detail-header">
      <div class="read-detail-meta">
        <img
          class="read-favicon"
          src={`https://www.google.com/s2/favicons?domain=${entry.data.domain}&sz=32`}
          alt=""
          referrerpolicy="no-referrer"
          width="16"
          height="16"
          loading="lazy"
        />
        <span class="read-author">{entry.data.author}</span>
        <span class="meta-dot">&middot;</span>
        <span class="read-domain">{entry.data.domain}</span>
        <span class="meta-dot">&middot;</span>
        <time datetime={isoDate}>{formattedDate}</time>
      </div>

      <h1 class="read-detail-title">{entry.data.title}</h1>

      <div class="takeaway-box">
        <span class="takeaway-label">Key Takeaway</span>
        <p class="takeaway-quote">{entry.data.takeaway}</p>
      </div>

      <div class="original-source-cta">
        <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="cta-button">
          Read Original Article on {entry.data.domain} &nearr;
        </a>
      </div>
    </header>

    <hr class="section-divider" />

    <!-- Personal Commentary Content -->
    <div class="read-body-content">
      <Content />
    </div>

    <!-- Structured Data Schema for SEO & LLMs -->
    <script type="application/ld+json" set:html={JSON.stringify(readSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Guest comments: approved thread is fetched client-side from /comments,
         new submissions POST to /comment and land in the moderation queue. -->
    <section class="comments-section" id="comments" data-post-id={`read-${entry.id}`}>
      <h2 class="comments-title">Discussion & Comments</h2>

      <ol class="comment-list" id="comment-list" hidden></ol>
      <p class="comments-note" id="comment-empty" hidden>
        No comments yet. Yours would be the first.
      </p>

      <p class="comments-note">
        Have thoughts on this recommendation? Share your perspective below.
        Comments are reviewed before they appear.
      </p>

      {turnstileSiteKey ? (
        <form class="comment-form" action="/comment" method="POST" id="comment-form">
          <input type="hidden" name="post_id" value={`read-${entry.id}`} />

          <div class="form-group">
            <label for="comment-author">Name</label>
            <input type="text" id="comment-author" name="author" required maxlength="80" placeholder="Your name or handle" class="form-input" />
          </div>

          <div class="form-group">
            <label for="comment-text">Comment</label>
            <textarea id="comment-text" name="comment" rows="4" required maxlength="4000" placeholder="Write your thoughts..." class="form-textarea"></textarea>
          </div>

          <!-- Cloudflare Turnstile Widget (SiteKey from PUBLIC_TURNSTILE_SITE_KEY) -->
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="turnstile-spin-v2" data-theme="auto"></div>

          <button type="submit" class="submit-comment-btn">Submit Comment</button>
          <p class="comment-status" id="comment-status" role="status" aria-live="polite" hidden></p>
        </form>
      ) : (
        <p class="comments-note">Comments are temporarily unavailable.</p>
      )}
    </section>

    <!-- Cloudflare Turnstile Script (only when comments are enabled) -->
    {turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
  </article>
</BaseLayout>

<script>
  // Comments are rendered client-side because the page itself is static.
  // Everything here degrades gracefully: with JS off the form still posts
  // normally and /comment 303s back with ?comment=received.
  (() => {
    const section = document.getElementById('comments');
    if (!section) return;

    const postId = section.dataset.postId;
    const list = document.getElementById('comment-list');
    const empty = document.getElementById('comment-empty');
    const form = document.getElementById('comment-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('comment-status');

    const setStatus = (message: string, kind: 'ok' | 'error') => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.dataset.kind = kind;
      statusEl.hidden = false;
    };

    const formatDate = (iso: string) => {
      const d = new Date(iso);
      return Number.isNaN(d.getTime())
        ? ''
        : d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    };

    // Built with textContent throughout - never innerHTML - so comment bodies
    // cannot inject markup.
    const render = (comments: Array<{ author: string; body: string; created_at: string }>) => {
      if (!list || !empty) return;
      list.textContent = '';

      if (!comments.length) {
        list.hidden = true;
        empty.hidden = false;
        return;
      }

      for (const c of comments) {
        const li = document.createElement('li');
        li.className = 'comment-item';

        const meta = document.createElement('div');
        meta.className = 'comment-meta';

        const author = document.createElement('span');
        author.className = 'comment-author';
        author.textContent = c.author;
        meta.appendChild(author);

        const when = formatDate(c.created_at);
        if (when) {
          const dot = document.createElement('span');
          dot.className = 'meta-dot';
          dot.textContent = '·';
          meta.appendChild(dot);

          const time = document.createElement('time');
          time.dateTime = c.created_at;
          time.textContent = when;
          meta.appendChild(time);
        }

        const body = document.createElement('p');
        body.className = 'comment-body';
        body.textContent = c.body;

        li.append(meta, body);
        list.appendChild(li);
      }

      empty.hidden = true;
      list.hidden = false;
    };

    const load = async () => {
      try {
        const res = await fetch(`/comments?post_id=${encodeURIComponent(postId ?? '')}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) return;
        const data = await res.json();
        if (data.ok) render(data.comments ?? []);
      } catch {
        // Offline or the endpoint is unavailable - leave the thread hidden
        // rather than showing an error above the form.
      }
    };

    // Surface the result of a no-JS submission that redirected back here.
    const flag = new URLSearchParams(window.location.search).get('comment');
    if (flag === 'received') {
      setStatus('Thanks. Your comment is awaiting review.', 'ok');
    } else if (flag === 'error') {
      setStatus('That comment could not be posted. Please try again.', 'error');
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (button) button.disabled = true;
      setStatus('Sending...', 'ok');

      try {
        const res = await fetch('/comment', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
        });
        const data = await res.json().catch(() => ({ ok: false }));

        if (res.ok && data.ok) {
          setStatus(data.message ?? 'Thanks. Your comment is awaiting review.', 'ok');
          form.reset();
        } else {
          setStatus(data.error ?? 'Something went wrong. Please try again.', 'error');
        }
      } catch {
        setStatus('Network error. Please try again.', 'error');
      } finally {
        if (button) button.disabled = false;
        // Each Turnstile token is single-use, so the widget needs resetting
        // whether the submission succeeded or not.
        (window as any).turnstile?.reset?.();
      }
    });

    load();
  })();
</script>

<!-- Comment thread styles live in src/styles/global.css, not in a scoped block
     here: the list is rendered at runtime so Astro's scoping would not match. -->
