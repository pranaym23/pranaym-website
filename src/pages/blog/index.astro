---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
// Sort posts by publication date in descending order (newest first)
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<BaseLayout title="Writing — Pranay" description="The full archive of essays, reflections, and technical articles by Pranay.">
  <section class="archive-section" style="margin-top: 2rem;">
    <h1 class="page-title">Writing Archive</h1>
    <p class="page-description">
      Essays and reflections on building companies, technology, and the things
      that stay with me — {sortedPosts.length} posts, oldest from {new Date(
        sortedPosts[sortedPosts.length - 1].data.pubDate
      ).getFullYear()}.
    </p>
    <p class="reads-feed-link" style="margin-bottom: 2rem;">
      <a href="/blog/rss.xml">RSS feed</a>
    </p>
    <ul class="post-list post-list--detailed">
      {sortedPosts.map((post) => {
        const dateObj = new Date(post.data.pubDate);
        const formattedDate = dateObj.toISOString().split('T')[0];

        return (
          <li class="post-item post-item--detailed">
            <time class="post-meta-date" datetime={dateObj.toISOString()}>{formattedDate}</time>
            <div class="post-item-body">
              <a href={`/blog/${post.id}/`} class="post-title-link post-title-link--lead">
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="post-item-description">{post.data.description}</p>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
