# Cloudflare Pages header rules. Copied verbatim into dist/ at build time.
# First matching rule set applies per header; more specific paths come last.

/*
  # Sent over HTTPS only; Pages already 301s http -> https at the edge.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  # Defence in depth. The site renders no user-supplied HTML (comment bodies go
  # through textContent), so this is a second line rather than the only one.
  # 'unsafe-inline' is required for scripts: BaseLayout ships the gtag snippet
  # and the anti-FOUC theme script inline, and Astro inlines component styles.
  # Allowed third parties: googletagmanager/google-analytics (gtag),
  # challenges.cloudflare.com (Turnstile), www.google.com (favicon service),
  # fonts.googleapis.com + fonts.gstatic.com (the Newsreader/Inter @import in
  # global.css - the stylesheet is style-src, the woff2 files are font-src).
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://www.google.com https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net; frame-src https://challenges.cloudflare.com; manifest-src 'self'; upgrade-insecure-requests

# Astro emits content-hashed filenames under /_astro/, so these can never go
# stale — cache them for a year and skip revalidation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media keeps its own filename across deploys, so revalidate daily
# rather than pinning it for a year.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=604800

# Feeds and crawler files should stay fresh.
/blog/rss.xml
  Cache-Control: public, max-age=1800
  Content-Type: application/rss+xml; charset=utf-8

/reads/rss.xml
  Cache-Control: public, max-age=1800
  Content-Type: application/rss+xml; charset=utf-8

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
