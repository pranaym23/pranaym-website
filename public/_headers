# Cloudflare Pages header rules. Copied verbatim into dist/ at build time.
# First matching rule set applies per header; more specific paths come last.

/*
  # Sent over HTTPS only; Pages already 301s http -> https at the edge.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Astro emits content-hashed filenames under /_astro/, so these can never go
# stale — cache them for a year and skip revalidation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media keeps its own filename across deploys, so revalidate daily
# rather than pinning it for a year.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=604800

# Feeds and crawler files should stay fresh.
/blog/rss.xml
  Cache-Control: public, max-age=1800
  Content-Type: application/rss+xml; charset=utf-8

/reads/rss.xml
  Cache-Control: public, max-age=1800
  Content-Type: application/rss+xml; charset=utf-8

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
